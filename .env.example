# 启动前请通过环境变量或部署平台注入；程序不会自动加载此文件。
LISTEN_ADDR=:8080
DB_TYPE=sqlite
DB_DSN=./data.db
# PostgreSQL 示例：postgres://ticket:password@localhost:5432/ticket_hub?sslmode=disable
REDIS_URL=
# 必填，至少 32 字节随机密钥；更换后已有会话及加密数据失效。
APP_SECRET_KEY=
ADMIN_USERNAME=admin
# 首次启动必填，12~72 字节；已有用户时忽略。
ADMIN_PASSWORD=
# HTTPS 生产环境必须开启。
COOKIE_SECURE=false
# 可选测试专用数据库，测试会创建和删除自身的数据。
TEST_PG_DSN=
# 可选，专用 Redis 测试实例（测试仅操作带唯一前缀的键）。
TEST_REDIS_URL=
# 生产环境保持 false；true 时允许管理员通过 /api/dev/tickets 注入工单。
DEV_MODE=false
# Docker Compose 专用；主配置使用容器内 PostgreSQL/Redis 地址。
POSTGRES_USER=ticket
POSTGRES_DB=ticket_hub
# 使用 openssl rand -hex 24 生成，避免连接 URL 中的特殊字符。
POSTGRES_PASSWORD=
APP_BIND=127.0.0.1
APP_PORT=8080
